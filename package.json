{
  "name": "mischa-gohlke-band-tina",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "node scripts/build-legacy-css.mjs && NODE_ENV=production tinacms build && NODE_ENV=production next build",
    "postbuild": "next-sitemap --config next-sitemap.config.mjs",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build:local": "node scripts/build-legacy-css.mjs && NODE_ENV=production tinacms build --local --skip-cloud-checks --port 19880 --datalayer-port 19881 -c \"next build\"",
    "build:legacy-css": "node scripts/build-legacy-css.mjs"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^1.7.14",
    "@heroicons/react": "^2.0.17",
    "@tabler/icons-react": "^2.16.0",
    "@tailwindcss/forms": "^0.5.3",
    "@vercel/analytics": "^1.0.0",
    "blurhash": "^2.0.5",
    "clsx": "^1.2.1",
    "focus-visible": "^5.2.0",
    "fuse.js": "^6.6.2",
    "globby": "^13.1.4",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "hash.js": "^1.1.7",
    "image-size": "^1.0.2",
    "jsdom": "^21.1.1",
    "next": "15.5.26",
    "next-sitemap": "^4.0.7",
    "node-mailjet": "^3.3.7",
    "postcss-focus-visible": "^6.0.4",
    "react": "18.3.1",
    "react-blurhash": "^0.3.0",
    "react-dom": "18.3.1",
    "react-grid-gallery": "^1.0.0",
    "react-medium-image-zoom": "^5.1.4",
    "react-player": "^2.12.0",
    "sharp": "0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "4.3.3",
    "tinacms": "3.14.1",
    "caravaggio": "3.9.0",
    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "^5.9.3",
    "@tinacms/cli": "3.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "18",
    "@types/react-dom": "^18.3.0",
    "@csstools/postcss-cascade-layers": "6.0.0",
    "@csstools/postcss-oklab-function": "5.0.12",
    "@eslint/eslintrc": "3.3.7",
    "@shadcn/lint": "0.2.0",
    "@typescript-eslint/parser": "8.70.1",
    "postcss": "8.5.28"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "sharp": "0.34.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "@tinacms/cli@3.1.0": "patches/@tinacms__cli@3.1.0.patch",
      "caravaggio@3.9.0": "patches/caravaggio@3.9.0.patch"
    }
  }
}
