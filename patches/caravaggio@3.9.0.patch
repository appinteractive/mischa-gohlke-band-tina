+"use strict";
+Object.defineProperty(exports, "__esModule", { value: true });
+const sharp = require("sharp");
+// Keep the full image sharp over a blurred, edge-to-edge copy of itself.
+const social = ({ image }) => async ({ width, height }) => {
+    const [background, foreground] = await Promise.all([
+        image.clone().flatten({ background: "#ffffff" })
+            .resize(width, height, { fit: "cover" }).blur(30).png().toBuffer(),
+        image.clone().resize(width, height, { fit: "inside" }).png().toBuffer(),
+    ]);
+    return sharp(background).composite([{ input: foreground, gravity: "centre" }]);
+};
+exports.default = social;
